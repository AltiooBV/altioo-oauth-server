{# The client name is self-declared, so every value is escaped explicitly, whatever the environment's autoescape setting. #}
{# Rendered by the portal's My profile with the array src/Hook/PortalConnections.php provides, as aData. #}

<div id="altioo-oauth-server-connections" class="col-sm-12">
	<div class="panel panel-default">
		<div class="panel-heading">
			<h3 class="panel-title">{{ aData.title|e('html') }}</h3>
		</div>
		<div class="panel-body">
			<p>{{ aData.intro|e('html') }}</p>
			{% if aData.connections is empty %}
				<p>{{ aData.empty|e('html') }}</p>
			{% else %}
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr>
								{% for sColumn in aData.columns %}<th>{{ sColumn|e('html') }}</th>{% endfor %}
							</tr>
						</thead>
						<tbody>
							{% for aConnection in aData.connections %}
								<tr>
									<td>{{ aConnection.client|e('html') }}</td>
									<td>{{ aConnection.scopes|e('html') }}</td>
									<td>{{ aConnection.since|e('html') }}</td>
									<td>{{ aConnection.last_used|e('html') }}</td>
									<td>
										<form method="post">
											<input type="hidden" name="sTab" value="{{ aData.tab|e('html_attr') }}">
											<input type="hidden" name="operation" value="{{ aData.operation|e('html_attr') }}">
											<input type="hidden" name="transaction_id" value="{{ aData.transaction_id|e('html_attr') }}">
											<input type="hidden" name="grant_id" value="{{ aConnection.id|e('html_attr') }}">
											<button type="submit" class="btn btn-danger btn-sm">{{ aData.disconnect_label|e('html') }}</button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</div>
	</div>
</div>
