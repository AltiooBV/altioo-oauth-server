{
  "name": "altioo/altioo-oauth-server",
  "type": "itop-extension",
  "description": "OAuth 2.1 authorization server for iTop: Claude and other OAuth clients connect with the person's iTop login and receive an ordinary, expiring personal token.",
  "keywords": ["itop", "oauth", "oauth2", "authorization-server", "mcp"],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/AltiooBV/altioo-oauth-server",
  "authors": [
    {
      "name": "Altioo",
      "homepage": "https://github.com/AltiooBV",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/AltiooBV/altioo-oauth-server/issues",
    "source": "https://github.com/AltiooBV/altioo-oauth-server",
    "docs": "https://github.com/AltiooBV/altioo-oauth-server/blob/main/README.md",
    "security": "https://github.com/AltiooBV/altioo-oauth-server/blob/main/SECURITY.md",
    "email": "security@altioo.com"
  },
  "require": {
    "php": ">=8.2 <8.5",
    "composer-runtime-api": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Altioo\\iTop\\Extension\\OAuthServer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Altioo\\iTop\\Extension\\OAuthServer\\Test\\": "tests/php-unit-tests"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "sbom": "php tools/sbom.php"
  },
  "scripts-descriptions": {
    "lint": "Checks the hand-written PHP against Combodo's coding standard (tools/phpcs/iTop). Needs phpcs on the PATH.",
    "lint:fix": "Applies the fixable half of what lint reports.",
    "sbom": "Writes a CycloneDX bill of materials for the production dependencies to stdout."
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "preferred-install": "dist",
    "platform": {
      "php": "8.2.0"
    },
    "autoloader-suffix": "AltiooOAuthServerExtension"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
