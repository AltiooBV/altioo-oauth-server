      <methods>
        <method id="ComputeValues">
          <comment>/** The client ID is generated, so that nobody picks a guessable one. */</comment>
          <static>false</static>
          <access>public</access>
          <type>Overload-DBObject</type>
          <code><![CDATA[	public function ComputeValues()
	{
		parent::ComputeValues();
		if (strlen((string) $this->Get('client_id')) === 0) {
			$this->Set('client_id', \Altioo\iTop\Extension\OAuthServer\Secret::NewClientId());
		}
		if (strlen((string) $this->Get('creation_date')) === 0) {
			$this->SetCurrentDate('creation_date');
		}
	}]]></code>
        </method>
