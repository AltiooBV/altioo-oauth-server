  <module_parameters>
    <parameters id="altioo-oauth-server" _delta="define">
      <!--
        Redirect URIs a client may register, matched exactly. Claude's own is
        the default; an instance that also serves another client adds it here.
      -->
      <redirect_uris type="array">
        <item>https://claude.ai/api/mcp/auth_callback</item>
      </redirect_uris>
      <!-- Also accept http://localhost and http://127.0.0.1 on any port and path (RFC 8252), for local clients. -->
      <allow_loopback type="bool">false</allow_loopback>
      <!--
        Registrations accepted from one IP address per hour. Generous on purpose:
        every person who connects Claude registers from Anthropic's addresses.
      -->
      <registration_rate_limit type="int">300</registration_rate_limit>
      <!-- Registrations accepted per hour from all addresses together. -->
      <registration_global_limit type="int">1000</registration_global_limit>
      <!--
        Origins allowed to read the metadata, registration and token responses
        from a browser, for browser-based clients such as the MCP Inspector.
        Empty sends no CORS header at all, which is what Claude, calling from
        its servers, needs. Never "*".
      -->
      <allowed_origins type="array"/>
      <code_lifetime type="int">60</code_lifetime>
      <access_token_lifetime type="int">3600</access_token_lifetime>
      <!-- How long a rotated refresh token is still accepted, so that a lost response does not end a connection. -->
      <refresh_grace_seconds type="int">30</refresh_grace_seconds>
      <!-- A connection unused this long ends. -->
      <grant_idle_days type="int">30</grant_idle_days>
      <!-- How long an ended connection is kept, as the record of what happened, before the clean-up deletes it. -->
      <ended_grant_retention_days type="int">90</ended_grant_retention_days>
      <!-- A connection ends this long after it was made, whatever happens. -->
      <max_grant_days type="int">90</max_grant_days>
      <!--
        The resources a token may be granted for. Empty means the two the
        extension ships with: altioo-mcp's endpoint (scopes MCP*) and iTop's
        REST/JSON API (scope REST/JSON), at this instance's own URLs. The README
        gives the format.
      -->
      <resources type="array"/>
    </parameters>
  </module_parameters>
