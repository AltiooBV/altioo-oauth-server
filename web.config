<?xml version="1.0" encoding="utf-8" ?>
<!--
	The IIS twin of this module's .htaccess, and it must stay in step with it.

	Nothing is served by default - allowUnlisted="false" with no extension listed
	denies every request - and .php is granted back for index.php, the module's
	one entry point. The rewrite serves the two discovery documents clients look
	for inside the issuer path; it needs the IIS URL Rewrite module, without which
	IIS refuses the whole file, so the README says to install it.
-->
<configuration>
  <system.webServer>
      <security>
         <requestFiltering>
            <fileExtensions applyToWebDAV="false" allowUnlisted="false" />
            <hiddenSegments>
               <add segment="src" />
               <add segment="vendor" />
               <add segment="tests" />
               <add segment="doc" />
            </hiddenSegments>
         </requestFiltering>
      </security>
      <rewrite>
        <rules>
          <rule name="altioo-oauth-server discovery" stopProcessing="true">
            <match url="^\.well-known/(openid-configuration|oauth-authorization-server)$" />
            <action type="Rewrite" url="index.php?route={R:1}" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
  </system.webServer>

  <location path="index.php">
    <system.webServer>
        <security>
           <requestFiltering>
              <fileExtensions applyToWebDAV="false" allowUnlisted="false">
                 <add fileExtension=".php" allowed="true" />
              </fileExtensions>
           </requestFiltering>
        </security>
    </system.webServer>
  </location>
</configuration>
