<?xml version="1.0" encoding="utf-8" ?>
<!--
	The IIS twin of this module's .htaccess, and it must stay in step with it.

	Nothing is served by default: allowUnlisted="false" with no extension listed
	denies every file, and .php is granted back for index.php, the module's one
	entry point. src/, vendor/, templates/, tests/ and doc/ are hidden segments
	besides, so they stay out of reach whatever else changes here. Only GET,
	HEAD, POST and OPTIONS (a CORS preflight) are accepted.

	The rewrite serves the two discovery documents clients look for inside the
	issuer path. It needs the IIS URL Rewrite module, without which IIS refuses
	the whole file, so the README says to install it. Those two URLs have no
	extension, and request filtering would refuse them as unlisted; the
	location below lets extensionless requests through under .well-known only,
	where nothing exists on disk and the rewrite is all there is.
-->
<configuration>
  <system.webServer>
      <security>
         <requestFiltering>
            <fileExtensions applyToWebDAV="false" allowUnlisted="false" />
            <verbs allowUnlisted="false">
               <add verb="GET" allowed="true" />
               <add verb="HEAD" allowed="true" />
               <add verb="POST" allowed="true" />
               <add verb="OPTIONS" allowed="true" />
            </verbs>
            <hiddenSegments>
               <add segment="src" />
               <add segment="vendor" />
               <add segment="templates" />
               <add segment="tests" />
               <add segment="doc" />
            </hiddenSegments>
         </requestFiltering>
      </security>
      <directoryBrowse enabled="false" />
      <rewrite>
        <rules>
          <rule name="altioo-oauth-server discovery" stopProcessing="true">
            <match url="^\.well-known/(openid-configuration|oauth-authorization-server)$" />
            <action type="Rewrite" url="index.php?route={R:1}" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
  </system.webServer>

  <location path="index.php">
    <system.webServer>
        <security>
           <requestFiltering>
              <fileExtensions applyToWebDAV="false" allowUnlisted="false">
                 <add fileExtension=".php" allowed="true" />
              </fileExtensions>
           </requestFiltering>
        </security>
    </system.webServer>
  </location>

  <location path=".well-known">
    <system.webServer>
        <security>
           <requestFiltering>
              <fileExtensions applyToWebDAV="false" allowUnlisted="false">
                 <add fileExtension="." allowed="true" />
              </fileExtensions>
           </requestFiltering>
        </security>
    </system.webServer>
  </location>
</configuration>
