# Serves index.php, and the two discovery documents clients look for inside
# the issuer path, and nothing else in this directory.
#
# The deny is inside a FilesMatch for the reason altioo-mcp's .htaccess gives
# at length: the compiled env-<env>/ root grants .php in a FilesMatch, and a
# plain directory-level deny here loses to it, which would serve every file
# under src/ and vendor/. Both sections are file context, so the grants must
# come after the deny.
#
# The discovery names are granted as well as index.php because Apache decides
# access on the requested path before the rewrite below runs. They name no
# file, so the grant serves nothing but the rewrite.
#
# Keep this in step with web.config, which does the same job on IIS.

<IfModule mod_authz_core.c>
	# Apache 2.4
	<FilesMatch ".">
		Require all denied
	</FilesMatch>
	<FilesMatch "^(index\.php|openid-configuration|oauth-authorization-server)$">
		Require all granted
	</FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
	# Apache 2.2
	<FilesMatch ".">
		Deny from all
		Satisfy All
	</FilesMatch>
	<FilesMatch "^(index\.php|openid-configuration|oauth-authorization-server)$">
		Order Allow,Deny
		Allow from all
	</FilesMatch>
</IfModule>

# <issuer>/.well-known/openid-configuration is where an MCP client looks for
# an authorization server whose issuer has a path; the RFC 8414 name is served
# too. The site-root forms need a rewrite outside this directory: see the README.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^\.well-known/(openid-configuration|oauth-authorization-server)$ index.php?route=$1 [L,QSA]
</IfModule>

# Apache 2.2 and 2.4
IndexIgnore *
